# AI Sales Copilot Backend Environment Variables

# The port Express will listen on
PORT=3001

# Your Google AI Studio API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# HH.ru API Access Token (from https://dev.hh.ru/)
HH_API_TOKEN=your_hh_api_token_here

# DaData API Keys (from https://dadata.ru/)
DADATA_API_KEY=your_dadata_api_key_here
DADATA_SECRET_KEY=your_dadata_secret_key_here
