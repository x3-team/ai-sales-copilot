# Local only. Copy to .env and fill. Never commit .env.
DEMO_MODE=0

# DaData — ЕГРЮЛ, ИНН, директор
DADATA_API_KEY=
DADATA_SECRET_KEY=

# HH Vacancies API (public) + optional Employer resume search
HH_USER_AGENT=AI-Sales-Copilot/1.0 (you@email.com)
HH_ACCESS_TOKEN=

# Tenderland — закупки 44/223 + коммерческие площадки (JSON). Дешевле SOAP ЕИС по трудозатратам.
# Тест 3 дня: tenderland.ru, попросите API-ключ. Не коммитьте ключ.
TENDERLAND_API_KEY=

# Optional pitch generation
GEMINI_API_KEY=

# SQLite lives in ./data/ unless you override
# COPILOT_MEMORY_DB_PATH=data/copilot_memory.db
# LPR_JOBS_DB_PATH=data/lpr_jobs.db

# Optional local webhooks (http://127.0.0.1 is allowed)
WEBHOOK_BASE_URL=http://127.0.0.1:8000
WEBHOOK_HMAC_SECRET=
WEBHOOK_ALLOW_HTTP=1
